{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://choosh.dev/protocol/v1/workspace.schema.json",
  "title": "Choosh workspace",
  "type": "object",
  "required": ["id", "name", "project_root", "zellij_session", "revision"],
  "properties": {
    "id": { "type": "string", "format": "uuid" },
    "name": { "type": "string", "minLength": 1, "maxLength": 128 },
    "project_root": { "type": "string", "minLength": 1, "maxLength": 4096 },
    "zellij_session": { "type": "string", "minLength": 1, "maxLength": 128 },
    "revision": { "type": "integer", "minimum": 1 },
    "created_at": { "type": "string", "format": "date-time" },
    "updated_at": { "type": "string", "format": "date-time" }
  },
  "additionalProperties": false
}

